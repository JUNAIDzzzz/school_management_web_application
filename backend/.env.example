PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/school_management

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Default Admin account created by the seed script
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=School Administrator

# Default Finance account created by the seed script
FINANCE_EMAIL=finance@school.com
FINANCE_PASSWORD=finance123
FINANCE_NAME=Finance Officer
